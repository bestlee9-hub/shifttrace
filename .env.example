# Firebase web app configuration (browser identifiers; no provider or service-account secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Production App Check site key for the deployed origin.
VITE_RECAPTCHA_SITE_KEY=

# Optional: localhost development only. Set true in your private .env.local.
# Never store a debug token value in a VITE_ variable.
VITE_LOCAL_APPCHECK_DEBUG=false
